  },
  "dependencies": {
    "@fin/core": "workspace:*",
    "@fin/server": "workspace:*",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
