{
  "name": "@fin/connector",
  "private": true,
  "type": "module",
  "description": "The connector supervisor: renders cloudflared's configuration from the ingress map and supervises it. No third-party dependency at run time.",
  "scripts": {
    "build": "vite build --config vite.server.config.ts",
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fin/core": "workspace:*",
    "@fin/server": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
