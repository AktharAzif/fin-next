{
  "name": "@fin/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:server",
    "build:server": "vite build --config vite.server.config.ts",
    "start:server": "node --enable-source-maps --disable-proto=throw dist/server/main.js",
    "lint": "biome check .",
    "typecheck": "node ../../packages/audit/src/gen.ts && tsc -p tsconfig.json",
    "test": "node ../../packages/audit/src/gen.ts && vitest run --config src/migrate/vitest.config.ts && vitest run src/doors",
    "test:db": "node ../../packages/audit/src/gen.ts && vitest run --config src/migrate/vitest.db.config.ts"
  },
  "dependencies": {
    "@fin/audit": "workspace:*",
    "@fin/core": "workspace:*",
    "@fin/crypto": "workspace:*",
    "@fin/db": "workspace:*",
    "@fin/server": "workspace:*",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fin/web-host": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
