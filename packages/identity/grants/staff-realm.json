{
  "$comment": "The staff realm's sign-in tables (spec 02 §13.7, fin_admin's row, for the tables this lane creates). L-SAT-04's staff.json adds the staff roles, the change lock and its views.",
  "area": "staff-realm",
  "grants": [
    {
      "on": "schema",
      "name": "staff",
      "privileges": ["USAGE"],
      "to": ["fin_api", "fin_worker", "fin_admin", "fin_readonly"]
    },
    {
      "on": "table",
      "name": "staff.member",
      "privileges": ["SELECT", "INSERT", "UPDATE", "DELETE"],
      "to": ["fin_admin"]
    },
    {
      "on": "table",
      "name": "staff.session",
      "privileges": ["SELECT", "INSERT", "UPDATE", "DELETE"],
      "to": ["fin_admin"]
    },
    {
      "on": "table",
      "name": "staff.account",
      "privileges": ["SELECT", "INSERT", "UPDATE", "DELETE"],
      "to": ["fin_admin"]
    },
    {
      "on": "table",
      "name": "staff.verification",
      "privileges": ["SELECT", "INSERT", "UPDATE", "DELETE"],
      "to": ["fin_admin"]
    },
    {
      "on": "table",
      "name": "staff.passkey",
      "privileges": ["SELECT", "INSERT", "UPDATE", "DELETE"],
      "to": ["fin_admin"]
    },
    {
      "on": "table",
      "name": "staff.two_factor",
      "privileges": ["SELECT", "INSERT", "UPDATE", "DELETE"],
      "to": ["fin_admin"]
    },
    {
      "on": "table",
      "name": "staff.assurance",
      "privileges": ["SELECT", "INSERT", "UPDATE", "DELETE"],
      "to": ["fin_admin"]
    },
    {
      "on": "table",
      "name": "staff.totp_step",
      "privileges": ["SELECT", "INSERT", "UPDATE", "DELETE"],
      "to": ["fin_admin"]
    },
    {
      "on": "table",
      "name": "staff.enrolment_code",
      "privileges": ["SELECT", "INSERT", "UPDATE", "DELETE"],
      "to": ["fin_admin"]
    },
    {
      "on": "table",
      "name": "staff.session_view",
      "privileges": ["SELECT"],
      "to": ["fin_api"]
    },
    {
      "on": "table",
      "name": "staff.proof_view",
      "privileges": ["SELECT"],
      "to": ["fin_api"]
    },
    {
      "on": "table",
      "name": "staff.member_view",
      "privileges": ["SELECT"],
      "to": ["fin_api"]
    },
    {
      "on": "function",
      "name": "staff.sweep()",
      "privileges": ["EXECUTE"],
      "to": ["fin_worker"]
    },
    {
      "on": "table",
      "name": "staff.member",
      "privileges": ["SELECT"],
      "to": ["fin_readonly"]
    },
    {
      "on": "table",
      "name": "staff.assurance",
      "privileges": ["SELECT"],
      "to": ["fin_readonly"]
    },
    {
      "on": "table",
      "name": "staff.totp_step",
      "privileges": ["SELECT"],
      "to": ["fin_readonly"]
    },
    {
      "on": "table",
      "name": "staff.session",
      "privileges": ["SELECT"],
      "columns": [
        "id",
        "user_id",
        "expires_at",
        "ip_address",
        "user_agent",
        "assurance",
        "absolute_expires_at",
        "created_via",
        "access_sub",
        "enrolment_open_until",
        "step_up_failures",
        "created_at",
        "updated_at"
      ],
      "to": ["fin_readonly"]
    },
    {
      "on": "table",
      "name": "staff.passkey",
      "privileges": ["SELECT"],
      "columns": [
        "id",
        "name",
        "public_key",
        "user_id",
        "credential_id",
        "counter",
        "device_type",
        "backed_up",
        "transports",
        "aaguid",
        "created_at"
      ],
      "to": ["fin_readonly"]
    },
    {
      "on": "table",
      "name": "staff.two_factor",
      "privileges": ["SELECT"],
      "columns": ["id", "user_id", "verified", "failed_verification_count", "locked_until"],
      "to": ["fin_readonly"]
    },
    {
      "on": "table",
      "name": "staff.enrolment_code",
      "privileges": ["SELECT"],
      "columns": [
        "id",
        "member_id",
        "reason",
        "issued_by",
        "issued_at",
        "expires_at",
        "redeemed_at",
        "redeemed_session_id",
        "voided_at",
        "failed_tries"
      ],
      "to": ["fin_readonly"]
    }
  ]
}
