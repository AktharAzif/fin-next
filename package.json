{
  "name": "fin-next",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.13.1 <27",
    "pnpm": "12.21.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "check": "TURBO_TELEMETRY_DISABLED=1 turbo run lint typecheck test lint:root typecheck:root test:root --continue && pnpm run layout:check && pnpm run supply-chain:check && pnpm run public-safety && pnpm run imports:check && pnpm run static:check",
    "layout:check": "node scripts/layout-check.mjs",
    "supply-chain:check": "node scripts/check-supply-chain.mjs",
    "public-safety": "node scripts/public-safety.mjs",
    "imports:check": "node scripts/import-rules.mjs",
    "static:check": "node scripts/static-check.mjs",
    "fin-review": "node tools/fin-review/src/main.ts",
    "build": "TURBO_TELEMETRY_DISABLED=1 turbo run build",
    "lint": "TURBO_TELEMETRY_DISABLED=1 turbo run lint lint:root",
    "typecheck": "TURBO_TELEMETRY_DISABLED=1 turbo run typecheck typecheck:root",
    "test": "TURBO_TELEMETRY_DISABLED=1 turbo run test test:root",
    "test:db": "TURBO_TELEMETRY_DISABLED=1 turbo run test:db --continue",
    "lint:root": "biome ci --error-on-warnings .",
    "typecheck:root": "tsc -p tsconfig.json",
    "test:root": "node --test \"scripts/test/*.test.mjs\""
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
