{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fin-review lens and attack session output (spec 07 §2.8)",
  "description": "The engine narrows lens, profile and checked[].item to the session's own values before it passes the schema to a session.",
  "type": "object",
  "additionalProperties": false,
  "required": ["done", "checked", "findings", "procedureGaps"],
  "properties": {
    "done": { "type": "boolean" },
    "checked": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "verdict"],
        "properties": {
          "item": { "type": "string", "pattern": "^[A-Z]{3}-[0-9]{2}$" },
          "verdict": { "type": "string", "enum": ["ok", "finding", "n/a"] }
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lens", "class", "severity", "title", "where", "quotes", "claim", "scenario", "testShouldFail", "preExisting"],
        "properties": {
          "lens": {
            "type": "string",
            "enum": ["correctness", "security", "quality", "performance", "rules", "joins", "test-truth", "infra", "dependency", "attack"]
          },
          "profile": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$" },
          "class": { "type": "string", "pattern": "^(C[0-9]{2,3}|unclassified|test-cannot-fail)$" },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "where": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "startLine", "endLine"],
              "properties": {
                "path": { "type": "string", "minLength": 1, "maxLength": 512 },
                "startLine": { "type": "integer", "minimum": 1, "maximum": 10000000 },
                "endLine": { "type": "integer", "minimum": 1, "maximum": 10000000 }
              }
            }
          },
          "quotes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "text"],
              "properties": {
                "path": { "type": "string", "minLength": 1, "maxLength": 512 },
                "text": { "type": "string", "minLength": 1, "maxLength": 300 }
              }
            }
          },
          "claim": { "type": "string", "minLength": 1, "maxLength": 600 },
          "scenario": { "type": "string", "minLength": 1, "maxLength": 800 },
          "ruleId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,39}$" },
          "testShouldFail": { "type": "string", "minLength": 1, "maxLength": 400 },
          "preExisting": { "type": "boolean" }
        }
      }
    },
    "procedureGaps": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string", "maxLength": 300 }
    },
    "priorBlockers": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^P[0-9]{1,3}$" },
          "status": { "type": "string", "enum": ["fixed", "open"] },
          "fixWhere": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "startLine", "endLine"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 512 },
              "startLine": { "type": "integer", "minimum": 1, "maximum": 10000000 },
              "endLine": { "type": "integer", "minimum": 1, "maximum": 10000000 }
            }
          },
          "fixQuote": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "text"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 512 },
              "text": { "type": "string", "minLength": 1, "maxLength": 300 }
            }
          }
        }
      }
    }
  }
}
