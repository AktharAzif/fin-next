{
  "name": "@fin/console",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:server",
    "build:server": "vite build --config vite.server.config.ts",
    "start:server": "node --enable-source-maps --disable-proto=throw dist/server/main.js",
    "lint": "biome check .",
    "typecheck": "pnpm run typecheck:server",
    "typecheck:server": "tsc -p src/server/tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:db": "vitest run --config ../../vitest.config.ts --mode db"
  },
  "dependencies": {
    "@fin/access": "workspace:*",
    "@fin/core": "workspace:*",
    "@fin/identity": "workspace:*",
    "@fin/orgs": "workspace:*",
    "@fin/server": "workspace:*",
    "@fin/web-host": "workspace:*",
    "better-auth": "catalog:",
    "hono": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
