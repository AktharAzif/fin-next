{
  "name": "@fin/api",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "biome check src/migrate src/tasks src/worker/probe",
    "typecheck": "node ../../packages/audit/src/gen.ts && tsc -p src/migrate/tsconfig.json",
    "pretest": "node ../../packages/audit/src/gen.ts",
    "test": "vitest run --config ../../vitest.config.ts",
    "pretest:db": "node ../../packages/audit/src/gen.ts",
    "test:db": "vitest run --config ../../vitest.config.ts --mode db"
  },
  "dependencies": {
    "@fin/audit": "workspace:*",
    "@fin/crypto": "workspace:*",
    "@fin/db": "workspace:*",
    "zod": "catalog:"
  }
}
