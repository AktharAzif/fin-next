    "common": [
      { "name": "event", "field": "event", "type": "string_low_cardinality", "aggregations": [] },
      { "name": "level", "field": "level", "type": "string_low_cardinality", "aggregations": [] },
      {
        "name": "service",
        "field": "service",
        "type": "string_low_cardinality",
        "aggregations": []
