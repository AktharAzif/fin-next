{
  "$comment": "The email area's grants (spec 01 §6.10; ARCHITECTURE §9.4). The outbox is in email_private, which only the worker and email.enqueue()'s owner may use, so no other login can name or lock it. Rows reach the outbox only through email.enqueue(), which runs as fin_email_enqueue (NOLOGIN): INSERT on the outbox and SELECT on the template grants, nothing more. Only the worker claims, updates and deletes rows. L-SAT-05 extends this fragment.",
  "area": "email",
  "grants": [
    {
      "on": "schema",
      "name": "email",
      "privileges": ["USAGE"],
      "to": [
        "fin_api",
        "fin_worker",
        "fin_payments",
        "fin_console",
        "fin_admin",
        "fin_email_enqueue"
      ]
    },
    {
      "on": "schema",
      "name": "email_private",
      "privileges": ["USAGE"],
      "to": ["fin_worker", "fin_email_enqueue"]
    },
    {
      "on": "function",
      "name": "email.enqueue(jsonb)",
      "privileges": ["EXECUTE"],
      "to": ["fin_api", "fin_worker", "fin_payments", "fin_console", "fin_admin"]
    },
    {
      "on": "table",
      "name": "email.template_grant",
      "privileges": ["SELECT"],
      "to": ["fin_email_enqueue"]
    },
    {
      "on": "table",
      "name": "email_private.outbox",
      "privileges": ["INSERT"],
      "to": ["fin_email_enqueue"]
    },
    {
      "on": "table",
      "name": "email_private.outbox",
      "privileges": ["SELECT", "UPDATE", "DELETE"],
      "to": ["fin_worker"]
    }
  ]
}
