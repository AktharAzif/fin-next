{
  "name": "@fin/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fin Admin: the staff console behind Cloudflare Access. Its single-page app (src/client) and its API half (src/server)",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode production",
    "build:test": "vite build --mode test",
    "routes": "node scripts/generate-routes.mjs",
    "typecheck": "pnpm run routes && tsc -p tsconfig.json && tsc -p e2e/tsconfig.json",
    "lint": "biome check .",
    "test": "vitest run --config ../../vitest.config.ts",
    "e2e": "pnpm run build:test && node e2e/support/run.ts"
  },
  "dependencies": {
    "@fin/app-contracts": "workspace:*",
    "@fin/frame": "workspace:*",
    "@fin/icons": "workspace:*",
    "@fin/motion": "workspace:*",
    "@fin/tokens": "workspace:*",
    "@fin/ui": "workspace:*",
    "@simplewebauthn/browser": "catalog:",
    "@tanstack/react-router": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@fin/testing": "workspace:*",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:"
  }
}
