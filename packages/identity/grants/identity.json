    },
    {
      "role": "fin_readonly",
      "privileges": ["SELECT"],
      "table": "identity.trusted_browser",
      "columns": [
        "id",
        "user_id",
        "label",
        "created_at",
        "last_used_at",
        "expires_at",
        "revoked_at",
        "revoked_reason"
