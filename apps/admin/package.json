{
  "name": "@fin/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fin Admin: the staff console behind Cloudflare Access. Its single-page app (src/client) and its API half (src/server)",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode production && pnpm run build:server",
    "build:test": "vite build --mode test",
    "build:server": "vite build --config vite.server.config.ts",
    "start:server": "node --enable-source-maps --disable-proto=throw dist/server/main.js",
    "routes": "node scripts/generate-routes.mjs",
    "typecheck": "pnpm run routes && tsc -p tsconfig.json && pnpm run typecheck:server",
    "typecheck:server": "tsc -p src/server/tsconfig.json",
    "lint": "biome check .",
    "pretest": "pnpm run routes",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:db": "vitest run --config ../../vitest.config.ts --mode db",
    "e2e": "pnpm run build && playwright test"
  },
  "dependencies": {
    "@fin/access": "workspace:*",
    "@fin/app-contracts": "workspace:*",
    "@fin/core": "workspace:*",
    "@fin/db": "workspace:*",
    "@fin/frame": "workspace:*",
    "@fin/identity": "workspace:*",
    "@fin/motion": "workspace:*",
    "@fin/server": "workspace:*",
    "@fin/staff": "workspace:*",
    "@fin/tokens": "workspace:*",
    "@fin/ui": "workspace:*",
    "@fin/web-host": "workspace:*",
    "@tanstack/react-router": "catalog:",
    "hono": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fin/testing": "workspace:*",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
