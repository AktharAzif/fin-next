{
  "name": "@fin/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fin's controls and surfaces on the UI SDK (spec 06 §3)",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./shell": "./src/shell/index.ts"
  },
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts",
    "build:kit": "vite build --config vite.kit.config.ts --mode test",
    "e2e": "pnpm run build:kit && playwright test"
  },
  "dependencies": {
    "@fin/icons": "workspace:*",
    "@fin/motion": "workspace:*",
    "@ui-sdk/core": "catalog:",
    "@ui-sdk/react": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@fin/tokens": "workspace:*",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
