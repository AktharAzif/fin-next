{
  "version": 1,
  "controlPaths": [
    ".github/",
    ".claude/",
    "CODEOWNERS",
    "AGENTS.md",
    "CLAUDE.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "pnpm-workspace.yaml",
    "scripts/check-supply-chain.mjs",
    "scripts/public-safety.mjs",
    "tools/fin-review/",
    "tools/layout.json",
    "docs/review/",
    "ops/fin/",
    "ops/docker/",
    "tools/static-deploy/",
    "packages/web-host/src/static/",
    "apps/*/static.json"
  ],
  "entries": [
    {
      "path": ".",
      "kind": "root",
      "name": "root",
      "status": "active",
      "files": [
        "package.json",
        "pnpm-workspace.yaml",
        "pnpm-lock.yaml",
        "turbo.json",
        "tsconfig.base.json",
        "biome.json",
        ".node-version",
        ".gitignore",
        "README.md",
        "AGENTS.md",
        "CLAUDE.md",
        "CONTRIBUTING.md",
        "SECURITY.md",
        "CODEOWNERS"
      ],
      "tiers": { "*.md": "D", "**": "S" }
    },
    {
      "path": "apps/console",
      "name": "@fin/console",
      "kind": "app",
      "status": "active",
      "tiers": { "src/server/**": "S", "static.json": "S", "**": "N" },
      "areas": ["console"],
      "image": "fin-next-console",
      "static": "console"
    },
    {
      "path": "apps/admin",
      "name": "@fin/admin",
      "kind": "app",
      "status": "active",
      "tiers": { "src/server/**": "S", "static.json": "S", "**": "N" },
      "image": "fin-next-admin",
      "static": "admin"
    },
    {
      "path": "apps/verify",
      "name": "@fin/verify",
      "kind": "app",
      "status": "active",
      "tiers": { "src/server/**": "S", "static.json": "S", "**": "N" },
      "image": "fin-next-verify",
      "static": ["verify", "selfie"]
    },
    {
      "path": "apps/docs",
      "name": "@fin/docs",
      "kind": "app",
      "status": "active",
      "tiers": { "src/try-it/**": "S", "static.json": "S", "**": "N" },
      "static": "docs"
    },
    {
      "path": "apps/edge",
      "name": "@fin/edge",
      "kind": "app",
      "status": "active",
      "tier": "S",
      "image": "fin-next-edge"
    },
    {
      "path": "apps/api",
      "name": "@fin/api",
      "kind": "app",
      "status": "active",
      "tier": "S",
      "image": "fin-next-api"
    },
    {
      "path": "apps/payments",
      "name": "@fin/payments",
      "kind": "app",
      "status": "planned",
      "tier": "S",
      "image": "fin-next-payments"
    },
    {
      "path": "apps/connector",
      "name": "@fin/connector",
      "kind": "app",
      "status": "planned",
      "tier": "S",
      "image": "fin-next-connector"
    },
    {
      "path": "packages/core",
      "name": "@fin/core",
      "kind": "package",
      "status": "active",
      "tier": "S"
    },
    {
      "path": "packages/server",
      "name": "@fin/server",
      "kind": "package",
      "status": "active",
      "tier": "S"
    },
    {
      "path": "packages/db",
      "name": "@fin/db",
      "kind": "package",
      "status": "active",
      "tier": "S"
    },
    {
      "path": "packages/crypto",
      "name": "@fin/crypto",
      "kind": "package",
      "status": "active",
      "tier": "S"
    },
    {
      "path": "packages/kyc",
      "name": "@fin/kyc",
      "kind": "package",
      "status": "planned",
      "tier": "S"
    },
    {
      "path": "packages/money",
      "name": "@fin/money",
      "kind": "package",
      "status": "planned",
      "tier": "S"
    },
    {
      "path": "packages/ui",
      "name": "@fin/ui",
      "kind": "package",
      "status": "active",
      "tier": "N"
    },
    {
      "path": "packages/tokens",
      "name": "@fin/tokens",
      "kind": "package",
      "status": "active",
      "tier": "N"
    },
    {
      "path": "packages/app-contracts",
      "name": "@fin/app-contracts",
      "kind": "package",
      "status": "active",
      "tier": "N"
    },
    {
      "path": "packages/contract",
      "name": "@fin/contract",
      "kind": "package",
      "status": "planned",
      "tier": "S"
    },
    {
      "path": "packages/testing",
      "name": "@fin/testing",
      "kind": "package",
      "status": "active",
      "tier": "S"
    },
    {
      "path": "tools/fin-review",
      "name": "@fin/fin-review",
      "kind": "tool",
      "status": "active",
      "tier": "S"
    },
    { "path": "ops/fin", "name": "@fin/ops-fin", "kind": "tool", "status": "active", "tier": "S" },
    {
      "path": "ops/backup",
      "name": "@fin/ops-backup",
      "kind": "tool",
      "status": "planned",
      "tier": "S",
      "image": "fin-next-backup"
    },
    { "path": "ops/docker", "kind": "ops", "status": "active", "tier": "S" },
    { "path": "ops/credentials.json", "kind": "ops", "status": "active", "tier": "S" },
    { "path": "scripts", "kind": "scripts", "status": "active", "tier": "S" },
    { "path": "docs/plan", "kind": "docs", "status": "active", "tier": "D" },
    { "path": "docs/review", "kind": "docs", "status": "active", "tier": "D" }
  ]
}
