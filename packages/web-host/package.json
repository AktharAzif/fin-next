{
  "name": "@fin/web-host",
  "private": true,
  "type": "module",
  "description": "The API host the app services share (ingress, origin gate, Access, problems, API headers) and the static hosts' header profiles with their renderer.",
  "exports": {
    ".": "./src/index.ts",
    "./static": "./src/static/render.ts",
    "./testing": "./src/testing.ts"
