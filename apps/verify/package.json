{
  "name": "@fin/verify",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The hosted verify pages a developer's customers open from a link, and the selfie host. Its single-page app (src/client) and its API half (src/server)",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode production && vite build --mode production --config vite.selfie.config.ts",
    "build:test": "vite build --mode test && vite build --mode test --config vite.selfie.config.ts",
    "routes": "node scripts/generate-routes.mjs",
    "typecheck": "pnpm run routes && tsc -p tsconfig.json",
    "lint": "biome check .",
    "test": "pnpm run routes && vitest run",
    "e2e": "pnpm run build && playwright test"
  },
  "dependencies": {
    "@fin/app-contracts": "workspace:*",
    "@fin/frame": "workspace:*",
    "@fin/motion": "workspace:*",
    "@fin/tokens": "workspace:*",
    "@fin/ui": "workspace:*",
    "@tanstack/react-router": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:"
  }
}
