{
  "name": "@fin/frame",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The web apps' frames, router glue, navigation trees, route states, theme bootstrap, env.json loader and api() client (spec 06 §2, §4, §5)",
  "sideEffects": [
    "*.css",
    "./src/report/index.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./report": "./src/report/index.ts",
    "./boot/*": "./boot/*"
  },
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build:harness": "vite build --config vite.harness.config.ts",
    "e2e": "pnpm run build:harness && playwright test"
  },
  "dependencies": {
    "@fin/app-contracts": "workspace:*",
    "@fin/icons": "workspace:*",
    "@fin/motion": "workspace:*",
    "@fin/ui": "workspace:*",
    "@tanstack/react-router": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  }
}
